{
  "name": "ai-limit-status",
  "displayName": "AI Limit Status",
  "description": "Displays Codex, Gemini, Argon, Other, and Claude subscription limits in one VS Code extension.",
  "version": "1.4.2",
  "publisher": "local-tools",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "icons": {
      "ai-limit-codex": {
        "description": "Codex brand mark",
        "default": {
          "fontPath": "./media/fonts/ai-limit-brand.woff",
          "fontCharacter": "\\ea02"
        }
      },
      "ai-limit-gemini": {
        "description": "Gemini brand mark",
